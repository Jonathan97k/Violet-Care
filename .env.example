# VioletCare Environment Variables
# Copy this file to .env and fill in the actual values

# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Google Apps Script Webhook URL for tracking
VITE_TRACKING_WEBHOOK=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Secret token for validating tracking requests
VITE_TRACKING_WEBHOOK_TOKEN=your_secret_token_here

# OpenRouter API Key for AI Chat (optional)
VITE_OPENROUTER_API_KEY=your_openrouter_api_key
