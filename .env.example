# VioletCare Environment Variables
# Copy this file to .env and fill in the actual values

# ============================================
# SUPABASE (Required for Auth & Admin Features)
# ============================================
# Get these from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Optional: Service Role Key (for Edge Functions only - DO NOT use in frontend)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ============================================
# AI ASSISTANT (Optional - for AI Chat feature)
# ============================================
# Get a free key from: https://openrouter.ai/keys
# 
# IMPORTANT: 
# - For LOCAL DEV: use VITE_OPENROUTER_API_KEY (works with Vite proxy)
# - For PRODUCTION on Vercel: use OPENROUTER_API_KEY (server-side only)
#   Add this in Vercel Dashboard → Settings → Environment Variables
#
# If neither is set, the AI chat will show a friendly error message
# and the rest of the app will work normally.

VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here

# For Vercel production deployment, also add (in Vercel dashboard, NOT in .env):
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# ============================================
# OPTIONAL: Usage Tracking (Google Sheets)
# ============================================
VITE_TRACKING_WEBHOOK=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
VITE_TRACKING_WEBHOOK_TOKEN=your_secret_token_here
