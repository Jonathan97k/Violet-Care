# VioletCare Environment Variables
# Copy this file to .env and fill in the actual values

# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Optional: Service Role Key (for Edge Functions only - DO NOT use in frontend)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Google Apps Script Webhook URL for tracking (optional)
VITE_TRACKING_WEBHOOK=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Secret token for validating tracking requests (optional)
VITE_TRACKING_WEBHOOK_TOKEN=your_secret_token_here

# OpenRouter API Key for AI Chat (optional)
VITE_OPENROUTER_API_KEY=your_openrouter_api_key
